int maxProfitf(int *arr, int minSize, int arrSize){
    if (arrSize - minSize <= 1) {
        return 0;
    }

    int mid = (minSize + arrSize) / 2;
    
    int x = maxProfitf(arr, minSize, mid);
    int y = maxProfitf(arr, mid, arrSize);
    int z = findMax(arr, mid, arrSize) - findMin(arr, minSize, mid);
    return max(x,y,z);
}

int max(x,y,z){
    if(x > y){
        if(x > z) return x;
        return z;
    }
    else{
        if(y > z) return y;
        return z;
    }
}

int findMax(int *arr, int minSize, int arrSize){
    int max = 0;
    for(int i = minSize; i < arrSize; i++){
        if (arr[i] > max) max = arr[i];
    }
    return max;
}

int findMin(int *arr, int minSize, int arrSize){
    int min = arr[minSize];
    for(int i = minSize+1; i < arrSize; i++){
        if (arr[i] > min) min = arr[i];
    }
    return min;
}


